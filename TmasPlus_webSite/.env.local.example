# Configuración de cliente PÚBLICO solamente. Copia a .env.local para la rama de prueba.
# NUNCA pongas service_role, secret keys ni contraseñas de cuentas en variables VITE_*.
#
# Integración consolidada + booking_v2 en Prueba. No apuntar a aplicacioncore.
VITE_SUPABASE_URL=https://lhqhdnjmewyipuwifzsl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_5jMmeQxiFz_1NPzITlcFKQ_M1kgTW0K
VITE_NODE_ENV=test
# Compatibilidad con utilidades antiguas; ambos nombres apuntan al MISMO proyecto.
VITE_SUPABASE_SECONDARY_URL=https://lhqhdnjmewyipuwifzsl.supabase.co
VITE_SUPABASE_SECONDARY_ANON_KEY=sb_publishable_5jMmeQxiFz_1NPzITlcFKQ_M1kgTW0K
# Necesaria para mapas y búsqueda de direcciones. Compartir la key de navegador
# autorizada para pruebas por canal privado; permitir el localhost usado por Vite.
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: token público de Mapbox para paridad de rutas con la app.
# Si queda vacío se usa el fallback de Google Directions.
VITE_MAPBOX_ACCESS_TOKEN=
