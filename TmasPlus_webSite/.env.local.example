# Configuración de cliente PÚBLICO solamente. Copia a .env.local para la rama de prueba.
# NUNCA pongas service_role, secret keys ni contraseñas de cuentas en variables VITE_*.
#
# Base consolidada: aplicacioncore (zvplcamcyldcquxqnftb).
VITE_SUPABASE_URL=https://zvplcamcyldcquxqnftb.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key de aplicacioncore>
VITE_NODE_ENV=test
# La base secundaria ya NO se usa (proyecto único). Puedes omitir VITE_SUPABASE_SECONDARY_*.
# Provee tu propia key de mapas restringida por navegador si el mapa la necesita.
